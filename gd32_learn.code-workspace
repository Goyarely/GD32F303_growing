{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        // clangd 使用 EIDE 构建后生成的 compile_commands.json（位置：<工程目录>/build/Debug）。
        // 切换活动工程后，把 --compile-commands-dir 改成对应工程的 build/Debug，
        // 否则索引会指向旧工程（头文件全标红）
        "clangd.arguments": [
            "--header-insertion=never",
            "--compile-commands-dir=./01-stm32-overview/build/Debug",
            "--query-driver=/usr/bin/arm-none-eabi-*"
        ],
        "files.autoGuessEncoding": true,
        "C_Cpp.default.configurationProvider": "cl.eide",
        "C_Cpp.errorSquiggles": "disabled",
        "C_Cpp.intelliSenseEngine": "disabled",
        "files.associations": {
            ".eideignore": "ignore",
            "*.a51": "a51",
            "*.h": "c",
            "*.c": "c",
            "*.hxx": "hxx",
            "*.hpp": "hpp",
            "*.c++": "cpp",
            "*.cpp": "cpp",
            "*.cxx": "cpp",
            "*.cc": "cpp"
        },
        "[yaml]": {
            "editor.insertSpaces": true,
            "editor.tabSize": 4,
            "editor.autoIndent": "advanced"
        }
    },
    "extensions": {
        "recommendations": [
            "cl.eide",
            "keroc.hex-fmt",
            "xiaoyongdong.srecord",
            "hars.cppsnippets",
            "zixuanwang.linkerscript",
            "redhat.vscode-yaml",
            "IBM.output-colorizer",
            "cschlosser.doxdocgen",
            "ms-vscode.vscode-serial-monitor",
            "dan-c-underwood.arm",
            "marus25.cortex-debug"
        ]
    }
}
